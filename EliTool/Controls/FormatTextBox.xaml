<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EliTool.Controls.FormatTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EliTool.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctkconverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:primitives="using:EliTool.Controls.Primitives"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ctkconverters:BoolToObjectConverter 
            x:Key="ItemBackgroundConverter"
            FalseValue="{ThemeResource ControlFillColorTertiaryBrush}"
            TrueValue="{ThemeResource AccentAcrylicBackgroundFillColorDefaultBrush}" />

        <ctkconverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="ItemsContainer" TargetType="GridView">
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="CharacterSpacing" Value="4"/>
            <Setter Property="SelectionMode" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled"/>
        </Style>

        <Style x:Key="Item" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinWidth" Value="48"/>
        </Style>

        <Border x:Key="FormatFlagItem" 
                Style="{ThemeResource Item}" 
                Background="{ThemeResource AccentAcrylicBackgroundFillColorDefaultBrush}"
                PointerEntered="Item_PointerEntered" PointerExited="Item_PointerExited">
            <StackPanel Visibility="{Binding IsFormatFlag, Converter={StaticResource BoolToVisibilityConverter}}"
                        Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Name="FormatDisplay">
                <TextBlock HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Text="{Binding DisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Name="DeleteButton" Visibility="Collapsed" Click="DeleteButton_Click" Tag="{Binding}" Padding="4" Margin="0">
                    <FontIcon Glyph="&#xE711;" FontSize="9"/>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Key="TextBlockItem"
                Style="{ThemeResource Item}"
                Background="{ThemeResource ControlFillColorTertiaryBrush}">
            <TextBox VerticalAlignment="Center" 
                     HorizontalAlignment="Center" 
                     BorderThickness="0,0,0,1" 
                     Text="{Binding DisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     TextChanged="TextBox_TextChanged"
                     Tag="{Binding}"
                     Background="Transparent"
                     Visibility="{Binding IsFormatFlag, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}"
                     MinWidth="48">
            </TextBox>
        </Border>
        
        <ContentDialog x:Name="EditFlyout" Closing="EditFlyout_Closing">
            <Grid Width="350" Height="480" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GridView Style="{ThemeResource ItemsContainer}" 
                              MinHeight="58" 
                              Padding="4">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ItemsPresenter">
                                <Border Style="{ThemeResource Item}"
                                        Background="{Binding IsFormatFlag, Converter={StaticResource ItemBackgroundConverter}}">
                                    <Grid>
                                        <TextBox VerticalAlignment="Center" 
                                                 HorizontalAlignment="Center" 
                                                 BorderThickness="0,0,0,1" 
                                                 Text="{Binding DisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 TextChanged="TextBox_TextChanged"
                                                 Tag="{Binding}"
                                                 Background="Transparent"
                                                 Visibility="{Binding IsFormatFlag, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}"
                                                 MinWidth="48">
                                        </TextBox>
                                        
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock Grid.Row="1" x:Name="ExampleText"/>
                </Grid>
                
                <GridViewItem BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="4"
                      Padding="8"
                      Height="72" 
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Grid.Row="1"
                      x:Name="SegmentTextBlock" PointerReleased="SegmentTextBlock_PointerReleased">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{ThemeResource Item}"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                Grid.Column="0"
                                Width="50"
                                Height="50">
                            <TextBlock HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       HorizontalTextAlignment="Center"
                                       FontSize="18">Text</TextBlock>
                        </Border>

                        <Grid VerticalAlignment="Center" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Grid.Row="0">Text block</TextBlock>
                            <TextBlock Grid.Row="1">A text block, extra of format flags.</TextBlock>
                        </Grid>
                    </Grid>
                    
                </GridViewItem>

                <GridView HorizontalAlignment="Stretch" 
                          HorizontalContentAlignment="Stretch"
                          VerticalAlignment="Stretch" 
                          Grid.Row="2" ItemsSource="{x:Bind FormatOptions}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="GridView_ItemClick">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid x:Name="MaxItemsWrapGrid"
                                           MaximumRowsOrColumns="1"
                                           Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:FormatOption">
                            <GridViewItem BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          CornerRadius="4"
                                          Padding="8"
                                          Height="72" 
                                          Width="346"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Grid.Row="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{ThemeResource Item}"
                                            Background="{ThemeResource AccentAcrylicBackgroundFillColorDefaultBrush}"
                                            Grid.Column="0"
                                            Width="50"
                                            Height="50">
                                        <TextBlock HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalTextAlignment="Center"
                                                   FontSize="18" Text="{Binding FormatFlag}"/>
                                    </Border>

                                    <Grid VerticalAlignment="Center" Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Grid.Row="0" Text="{Binding Title}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Description}"/>
                                    </Grid>
                                </Grid>
                            </GridViewItem>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </ContentDialog>
    </UserControl.Resources>
    <Grid CornerRadius="8" 
          Background="{ThemeResource ControlFillColorSecondaryBrush}" 
          BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
          BorderThickness="1"
          Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <GridView x:Name="InputBox" 
                  Style="{StaticResource ItemsContainer}"
                  ItemsSource="{Binding DisplayItems, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                  DataContext="{x:Bind ViewModel}"
                  Grid.Column="0">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ItemsPresenter">
                    <GridViewItem 
                            Background="{Binding IsFormatFlag, Mode=OneWay, Converter={StaticResource ItemBackgroundConverter}}" 
                            MinWidth="32"
                            MinHeight="32"
                            VerticalAlignment="Stretch">
                        <Border Style="{ThemeResource Item}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DisplayText, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </GridViewItem>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Button Margin="12,0,0,0" 
                x:Name="Edit" 
                Grid.Column="1" 
                VerticalAlignment="Center" 
                Visibility="Collapsed"
                Style="{ThemeResource AccentButtonStyle}"
                Height="48"
                Width="58"
                Click="Edit_Click">
            <StackPanel>
                <TextBlock>Edit</TextBlock>
                <FontIcon Glyph="&#xE70F;" FontSize="12"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
